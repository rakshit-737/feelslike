# Copy to .env (or set in your shell). Everything is OPTIONAL —
# with no key, the parser uses the offline rules fallback automatically.

# Pick ONE provider for the LLM parser:
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Model override (defaults: claude-haiku-4-5 / gpt-4o-mini)
# LLM_MODEL=

# FREE option: any OpenAI-compatible provider via OPENAI_API_KEY + LLM_BASE_URL.
# Groq (free tier, fastest — get key at console.groq.com):
#   OPENAI_API_KEY=gsk_...
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
# Google AI Studio (free tier — key at aistudio.google.com, ~10 req/min):
#   OPENAI_API_KEY=AIza...
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
# Ollama (local, fully offline):
#   OPENAI_API_KEY=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2
